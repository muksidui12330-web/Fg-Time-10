{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in FG TIME social network",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "fullName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "coverUrl": { "type": "string" },
        "bio": { "type": "string" },
        "website": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "isPrivate": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "lastActive": { "type": "string" },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "postsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "fullName"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat thread between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lastMessage": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participants"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "One-to-one message inside a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "isVoiceNote": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "senderId", "text"]
    },
    "Post": {
      "title": "Post",
      "description": "Feed post by a creator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "userAvatar": { "type": "string" },
        "caption": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "isVideo": { "type": "boolean" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "caption"]
    },
    "BetaFeedback": {
      "title": "BetaFeedback",
      "description": "Tester feedback and reviews",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "rating": { "type": "integer" },
        "category": { "type": "string" },
        "comment": { "type": "string" },
        "deviceModel": { "type": "string" },
        "osVersion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "comment"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Registered user profiles"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Direct chat conversation metadata"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Individual messages in a conversation"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Public social posts"
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/BetaFeedback" },
      "description": "Beta testing feedback submissions"
    }
  }
}
